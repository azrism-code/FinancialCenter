rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolios/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validLegacy() {
        return request.resource.data.keys().hasOnly(['items', 'alerts', 'updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 200
          && request.resource.data.alerts is list
          && request.resource.data.alerts.size() <= 500;
      }
      function validBook() {
        return request.resource.data.keys().hasOnly(['portfolios', 'activePortfolioId', 'updatedAt'])
          && request.resource.data.portfolios is list
          && request.resource.data.portfolios.size() > 0
          && request.resource.data.portfolios.size() <= 30
          && request.resource.data.activePortfolioId is string;
      }
      allow read: if owner();
      allow create, update: if owner()
        && request.resource.data.updatedAt is int
        && (validLegacy() || validBook());
      allow delete: if false;
    }
  }
}
