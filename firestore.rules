rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolios/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['items', 'alerts', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 200
        && request.resource.data.alerts is list && request.resource.data.alerts.size() <= 500
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }
  }
}
